# Go no carga este archivo automáticamente. Secretos solo en entorno local.
HTTP_ADDR=127.0.0.1:8080
# Origen exacto para pruebas HTTP locales. En HTTPS conserva COOKIE_SECURE=true.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Base permitida en fase A: elbravodeljac_test o elbravodeljac_dev.
POSTGRES_DSN=
# Al menos 32 bytes aleatorios en base64. Nunca publicar un valor real.
JWT_SECRET_BASE64=
# MongoDB todavía no se conecta en esta fase.
MONGODB_URI=
MONGODB_DATABASE=elbravodeljac_tecnico
