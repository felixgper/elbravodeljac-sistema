{
  "resultados_escaner": {
    "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticoId",
        "requestId",
        "capturadoPor",
        "capturadoEn",
        "registradoEn",
        "schemaVersion",
        "equipo",
        "dtcs",
        "mediciones",
        "_id",
        "payloadHash"
      ],
      "properties": {
        "diagnosticoId": {
          "bsonType": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "requestId": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "capturadoPor": {
          "bsonType": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "capturadoEn": {
          "bsonType": "date"
        },
        "registradoEn": {
          "bsonType": "date"
        },
        "schemaVersion": {
          "enum": [
            1
          ]
        },
        "equipo": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "nombre"
          ],
          "properties": {
            "nombre": {
              "bsonType": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "version": {
              "bsonType": "string",
              "maxLength": 80
            }
          }
        },
        "dtcs": {
          "bsonType": "array",
          "maxItems": 1000,
          "items": {
            "bsonType": "object",
            "additionalProperties": false,
            "required": [
              "codigo"
            ],
            "properties": {
              "codigo": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "descripcion": {
                "bsonType": "string",
                "maxLength": 1000
              }
            }
          }
        },
        "mediciones": {
          "bsonType": "object"
        },
        "_id": {
          "bsonType": "objectId"
        },
        "payloadHash": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "evidencias_tecnicas": {
    "$jsonSchema": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticoId",
        "requestId",
        "capturadoPor",
        "capturadoEn",
        "registradoEn",
        "schemaVersion",
        "descripcion",
        "mimeType",
        "sizeBytes",
        "sha256",
        "gridfsFileId",
        "_id",
        "payloadHash",
        "state",
        "leaseOwner",
        "leaseUntil"
      ],
      "properties": {
        "diagnosticoId": {
          "bsonType": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "requestId": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "capturadoPor": {
          "bsonType": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "capturadoEn": {
          "bsonType": "date"
        },
        "registradoEn": {
          "bsonType": "date"
        },
        "schemaVersion": {
          "enum": [
            1
          ]
        },
        "descripcion": {
          "bsonType": "string",
          "maxLength": 4000
        },
        "mimeType": {
          "enum": [
            "application/pdf",
            "image/jpeg",
            "image/png"
          ]
        },
        "sizeBytes": {
          "bsonType": [
            "int",
            "long"
          ],
          "minimum": 1,
          "maximum": 10485760
        },
        "sha256": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gridfsFileId": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "_id": {
          "bsonType": "objectId"
        },
        "payloadHash": {
          "bsonType": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "uploading",
            "ready"
          ]
        },
        "leaseOwner": {
          "bsonType": "string"
        },
        "leaseUntil": {
          "bsonType": "date"
        }
      }
    }
  }
}
