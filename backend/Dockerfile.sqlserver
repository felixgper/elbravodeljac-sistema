FROM golang:1.27.1-bookworm AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN mkdir /out && for command in api sqlserver-bootstrap mongo-init; do \
      CGO_ENABLED=0 go build -trimpath -o "/out/$command" "./cmd/$command" || exit 1; \
    done

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/ ./
COPY dist/ ./dist/
USER 65532:65532
CMD ["/app/api"]
