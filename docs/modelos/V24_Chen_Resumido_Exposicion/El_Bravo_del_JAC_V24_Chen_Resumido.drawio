        </mxCell>
        <mxCell id="guia" value="Clientes y vehículos → Recepción y diagnóstico → Cotización → Trabajo → Pago y entrega" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=30;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="100.0" y="205.0" width="3700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend-notation" value="LECTURA: (mínimo,máximo) describe a la entidad junto a la etiqueta. Rectángulo = entidad; rombo = relación. Sin atributos. El flujo continúa en la segunda fila de derecha a izquierda." style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=30;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="100.0" y="2490.0" width="3700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend-business" value="Servicio directo: recepción → cotización, sin diagnóstico. Orden solo con cotización aprobada. Entrega sujeta a cierre y saldo. * Relaciones resumidas mediante detalles, asignaciones o cuentas laborales. Vista de negocio; no modifica el modelo lógico/físico." style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=30;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="100.0" y="2610.0" width="3700" height="120" as="geometry" />
        </mxCell>
