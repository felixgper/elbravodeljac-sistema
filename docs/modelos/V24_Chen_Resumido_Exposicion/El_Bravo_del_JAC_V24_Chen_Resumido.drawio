        <mxCell id="title" value="EL BRAVO DEL JAC" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=56;fontStyle=1;" vertex="1" parent="1" connectable="0">
