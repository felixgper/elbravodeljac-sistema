        <mxCell id="title" value="EL BRAVO DEL JAC · MODELO CONCEPTUAL ENTIDAD–RELACIÓN · CHEN V21" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=38;" vertex="1" parent="1">
          <mxGeometry x="100.0" y="65.0" width="12100" height="70" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Una sola página · 24 entidades relacionales + 3 asociaciones N:M · 48 FK cubiertas · Complemento MongoDB separado conceptualmente" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100.0" y="145.0" width="12100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="RECTÁNGULO = entidad    ÓVALO = atributo    ROMBO = relación    Clave subrayada = identificador&lt;br&gt;Cada par (mín., máx.) se refiere a la entidad del conector rotulado; N = varios. Los sobrepasos de líneas NO son uniones. Sin flechas.&lt;br&gt;Los mínimos generales reflejan restricciones actuales; las condiciones por estado y las reglas de Go se explican en el informe." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="100.0" y="230.0" width="12100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mongo_note" value="COMPLEMENTO DOCUMENTAL · MongoDB&lt;br&gt;Resultados y evidencias: referencias lógicas discontinuas a DIAGNÓSTICOS y USUARIOS. No hay FK entre motores. Archivos: GridFS." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="6560.0" y="430.0" width="2500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="REGLAS DEL TALLER&lt;br&gt;Servicio directo: sin diagnóstico; siempre cotización aprobada antes de crear la orden.&lt;br&gt;Atención técnica: diagnóstico finalizado por el responsable asignado.&lt;br&gt;Asignación: MECÁNICO responsable y AUXILIAR son funciones distintas.&lt;br&gt;Auxiliar: consulta con su rol base; revisar excepción de permisos en el informe.&lt;br&gt;Pagos: anticipos o parciales; entrega de una orden finalizada con saldo neto cero.&lt;br&gt;Cargos laborales y roles de acceso son independientes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="4930.0" width="3650" height="340" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="LECTURA DEL MODELO&lt;br&gt;N:M: ASUME ROL, CONCEDE PERMISO y ABASTECE (con costo).&lt;br&gt;Los detalles, asignaciones y eventos tienen identidad e información propia.&lt;br&gt;Un vínculo opcional no equivale a un dato inventado: los mínimos 0 son deliberados.&lt;br&gt;Las asociaciones de responsabilidad conservan USUARIOS; EMPLEADOS no sustituye sus referencias históricas.&lt;br&gt;Aprobación, control técnico, conformidad e historiales son atributos compuestos.&lt;br&gt;Las cuentas legadas o técnicas pueden permanecer sin empleado." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="5320.0" width="3650" height="340" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Fuentes: respaldo estructural + migraciones 001–007 + reglas Go · Rama base 7dd2738 · 29/10/2026 · Solo documentación; sin cambios al sistema ni a los datos." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#193B66;fontFamily=Arial;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="100.0" y="5980.0" width="12100" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
