        <mxCell id="title" value="EL BRAVO DEL JAC · V23 · MODELO CONCEPTUAL CHEN RESUMIDO" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=40;fontStyle=1;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="150.0" y="33.0" width="9100" height="64" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Sin atributos · Una sola página · (mínimo,máximo) junto a su entidad · Propuestas P1–P3 explícitas; no son cambios aplicados" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=26;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="150.0" y="112.0" width="9100" height="46" as="geometry" />
        </mxCell>
        <mxCell id="area0" value="01 · CLIENTES Y VEHÍCULOS" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=24;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="100.0" y="214.0" width="2100" height="42" as="geometry" />
        </mxCell>
        <mxCell id="area1" value="02 · ATENCIÓN Y AUXILIO" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=24;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="2250.0" y="214.0" width="1900" height="42" as="geometry" />
        </mxCell>
        <mxCell id="area2" value="03 · COTIZACIÓN Y CATÁLOGOS" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=24;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="4400.0" y="214.0" width="2000" height="42" as="geometry" />
        </mxCell>
        <mxCell id="area3" value="04 · ÓRDENES, PAGOS Y ENTREGA" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=24;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="6650.0" y="214.0" width="2600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="area-personal" value="05 · PERSONAL Y ACCESOS" style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=24;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="850.0" y="4675.0" width="2000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend-notation" value="CÓMO LEER EL MODELO Rectángulo = entidad; rombo = relación. (0,1), (1,1), (0,N), (1,N) describen a la entidad junto a la etiqueta. Ejemplo: cliente (0,N) / vehículo (1,1). Vista resumida: se omiten todos los atributos. No es un esquema físico." style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=26;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="200.0" y="5275.0" width="3000" height="290" as="geometry" />
        </mxCell>
        <mxCell id="legend-proposals" value="MARCAS DE REVISIÓN — NO APLICADAS P1: cuenta interna con un empleado. P2: responsable humano EMPLEADO; autor autenticado USUARIO. P3: auxilio–recepción (0,1)/(0,1), pendiente de confirmar. Rombos ámbar = objetivo/proyección;&lt;br&gt;diferencias actuales en el informe." style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=26;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="3305.0" y="5275.0" width="2950" height="290" as="geometry" />
        </mxCell>
        <mxCell id="legend-business" value="REGLAS Y MOTORES B1: línea de servicio o repuesto; catálogo opcional, referencias excluyentes y concepto libre explícito. Cotización aprobada antes de orden; entrega no obligatoria. Rectángulos verde azulado = documentos MongoDB. Discontinua&lt;br&gt;= referencia entre motores, convención propia; no es notación oficial Chen." style="html=1;whiteSpace=wrap;fontFamily=Arial;align=center;verticalAlign=middle;text;strokeColor=none;fillColor=#FFFFFF;fontColor=#193B66;fontSize=26;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="6360.0" y="5275.0" width="2880" height="290" as="geometry" />
        </mxCell>
      </root>
