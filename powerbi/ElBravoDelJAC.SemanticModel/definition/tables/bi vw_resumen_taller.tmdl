		formatString: 0
		lineageTag: 505937aa-1b1e-4cd5-af5c-9a09e413863f
		summarizeBy: sum
		sourceColumn: TotalOrdenes

		annotation SummarizationSetBy = Automatic

	column TotalCotizaciones
